<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0C10">

    <com.zulu.ZuluPad
        android:id="@+id/zuluPad"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/btnF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="F: ON" />

        <Button
            android:id="@+id/btnZ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Z: ON" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START" />

        <Button
            android:id="@+id/btnMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MUTE" />

        <TextView
            android:id="@+id/tvFx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5FF5A"
            android:text="Fx: 35" />

        <TextView
            android:id="@+id/tvFy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5FF5A"
            android:text="Fy: 50" />

        <TextView
            android:id="@+id/tvZx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF7DCD"
            android:text="Zx: 65" />

        <TextView
            android:id="@+id/tvZy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF7DCD"
            android:text="Zy: 50" />

    </LinearLayout>
</LinearLayout>
